# StudentShare - Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Supports SQLite local file:studentshare.db or MySQL / TiDB mysql://user:pass@host:3306/db)
DATABASE_URL=file:studentshare.db

# Authentication Secrets
AUTH_SECRET=studentshare_super_secure_jwt_secret_key_2026_production_ready
JWT_EXPIRES_IN=7d

# Google OAuth Credentials (Optional / Configurable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3-Compatible Storage Configuration (AWS S3, MinIO, Cloudflare R2)
# If empty, StudentShare automatically uses secure local server storage in server/uploads/
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=studentshare-materials
STORAGE_REGION=us-east-1

# AI Integration (Optional - OpenAI / Gemini compatible)
# If empty, UI displays a clear "AI feature is not configured" state per project requirements
AI_API_KEY=

# Client API URL
VITE_API_URL=http://localhost:5000/api
