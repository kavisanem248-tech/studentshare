{
  "name": "studentshare-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --workspace=server run build",
    "build:client": "npm --workspace=client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "npm --workspace=server run start",
    "test": "node server/scripts/test-api.cjs",
    "lint": "npm --workspace=client run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
